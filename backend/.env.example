PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=uniraite
JWT_SECRET=cambia_esto_por_un_secreto_largo
# Dominios institucionales permitidos (separados por coma)
DOMINIOS_INSTITUCIONALES=alumnos.universidad.edu.mx,universidad.edu.mx
# Administrador inicial (npm run seed)
ADMIN_CORREO=admin@universidad.edu.mx
ADMIN_PASSWORD=Admin123!
# SMTP para enviar códigos de verificación (configura tu proveedor)
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_usuario_smtp
SMTP_PASSWORD=tu_password_smtp
SMTP_FROM="UniRaite <no-reply@tu-dominio.com>"
# Carpeta con la página de descarga, uniraite.apk y app/ (solo sin Nginx, p. ej. en Windows)
# WEB_DIR=C:\Users\garci\uniraite\publico
